{
  "permissions": {
    "allow": [
      "Bash(npx nx *)",
      "Bash(npm *)",
      "Bash(npx prisma *)",
      "Bash(npx playwright *)",
      "Bash(git *)",
      "Bash(printf *)",
      "Bash(cat *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "Agent"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(~/.ssh/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-reset.sh", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/interview-mode.sh", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-no-verify.sh", "timeout": 5 },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-command-secrets.sh", "timeout": 5 },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-quality.sh", "timeout": 10 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/console-log-check.sh", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/interview-stop-check.sh", "timeout": 10 } ] }
    ]
  }
}
